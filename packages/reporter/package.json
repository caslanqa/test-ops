{
  "name": "@testops/reporter",
  "version": "0.1.0",
  "description": "Playwright result reporting and test metadata sync for TestOps",
  "keywords": ["testops", "playwright", "test-reporter", "test-results"],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/caslanqa/test-ops.git",
    "directory": "packages/reporter"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "testops-sync": "./sync-cli.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./core": {
      "types": "./core.d.ts",
      "import": "./core.js",
      "default": "./core.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "reporter.js",
    "sync-cli.js",
    "sync-reporter.js",
    "core.js",
    "core.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "build": "node --check index.js && node --check reporter.js && node --check core.js && node --check sync-reporter.js && node --check sync-cli.js"
  }
}
