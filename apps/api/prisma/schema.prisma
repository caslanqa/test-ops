// TestOps - Prisma schema (Phase 1 core domain model)
// see design-doc.md section 4 (Domain model) and 6 (Functional requirements)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Workspace / Project / Membership (FR-001..FR-003)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  isActive     Boolean  @default(true)
  // Carried in every session token; a password change raises it, which ends older sessions.
  sessionVersion Int    @default(0)
  // When this user's own demo workspace was made (DemoService). It is made once, so a demo the
  // user deleted doesn't come back unasked.
  demoCreatedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceMemberships WorkspaceMember[]
  projectMemberships   ProjectMember[]
  apiTokens            ApiToken[]
  createdCases         TestCase[]        @relation("TestCaseCreatedBy")
  createdPlans         TestPlan[]        @relation("TestPlanCreatedBy")
  createdRuns          TestRun[]         @relation("TestRunCreatedBy")
  createdDefects       Defect[]          @relation("DefectCreatedBy")
  resultsAuthored      Result[]          @relation("ResultAuthor")
  attachmentsUploaded  Attachment[]      @relation("AttachmentUploader")
  auditLogEntries      AuditLog[]
  testCaseHistory      TestCaseHistory[]
  sentInvitations      WorkspaceInvitation[]

  @@map("users")
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  // Someone's demo workspace with the example shop project (DemoService).
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  projects    Project[]
  auditLog    AuditLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// People join a workspace through an invitation link (FR-002): the account with the invited
// email accepts it, or the link holder creates that account. Only the token's hash is stored;
// the link is shown once, to the admin who created it.
model WorkspaceInvitation {
  id          String        @id @default(uuid())
  workspaceId String
  email       String // lowercase
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_invitations")
}

enum ProjectRole {
  ADMIN // Project Admin / QA Lead
  TESTER
  AUTOMATION // Developer/Automation (token-based)
  VIEWER
}

model Project {
  id          String    @id @default(uuid())
  workspaceId String
  key         String // unique project key (within the workspace)
  name        String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  suites       Suite[]
  testCases    TestCase[]
  requirements Requirement[]
  milestones   Milestone[]
  plans        TestPlan[]
  runs         TestRun[]
  defects      Defect[]
  auditLog     AuditLog[]
  webhook      ProjectWebhook?

  @@unique([workspaceId, key])
  @@map("projects")
}

/// A project's CI webhook (FR-079): called when a run starts that has cases for automation to run,
/// so CI can run them. Secrets are encrypted at rest (common/secret-box.ts) and never returned.
model ProjectWebhook {
  id               String   @id @default(uuid())
  projectId        String   @unique
  url              String
  /// The TestOps address put in the calls (api_url, run links): PUBLIC_URL, or else the address the
  /// admin saved the webhook from. Never taken from the request that starts a run, so whoever starts
  /// one can't point CI, and the token CI reports with, at another server.
  baseUrl          String
  /// Extra request headers, e.g. Authorization for GitHub: encrypted JSON of { name: value }.
  headersEncrypted String?
  /// The names of those headers, so they can be listed without decrypting them.
  headerNames      String[] @default([])
  /// The key of the X-TestOps-Signature-256 HMAC, encrypted.
  secretEncrypted  String
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("project_webhooks")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One call of a project webhook, with its outcome, so people can see whether CI was reached.
model WebhookDelivery {
  id           String                @id @default(uuid())
  webhookId    String
  runId        String?
  /// "run.started", or "ping" for a test from the settings page.
  event        String
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  responseCode Int?
  error        String?
  createdAt    DateTime              @default(now())
  completedAt  DateTime?

  webhook ProjectWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  run     TestRun?       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([runId, createdAt])
  @@map("webhook_deliveries")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ---------------------------------------------------------------------------
// Test repository: Suite / TestCase / Steps (FR-010..FR-017)
// ---------------------------------------------------------------------------

model Suite {
  id          String   @id @default(uuid())
  projectId   String
  parentId    String?
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Suite?     @relation("SuiteHierarchy", fields: [parentId], references: [id])
  children  Suite[]    @relation("SuiteHierarchy")
  testCases TestCase[]

  @@map("suites")
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseSeverity {
  MINOR
  NORMAL
  MAJOR
  BLOCKER
}

enum CaseType {
  FUNCTIONAL
  SMOKE
  REGRESSION
  SECURITY
  PERFORMANCE
  OTHER
}

enum AutomationStatus {
  MANUAL
  TO_BE_AUTOMATED
  AUTOMATED
}

model TestCase {
  id               String           @id @default(uuid())
  projectId        String
  suiteId          String?
  title            String
  preconditions    String?
  description      String?
  priority         CasePriority     @default(MEDIUM)
  severity         CaseSeverity     @default(NORMAL)
  type             CaseType         @default(FUNCTIONAL)
  automationStatus AutomationStatus @default(MANUAL)
  tags             String[]        @default([])
  customFields     Json?
  isAutoCreated    Boolean          @default(false) // auto-created from an automation result? (FR-017)
  archivedAt       DateTime?
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite        Suite?            @relation(fields: [suiteId], references: [id])
  createdBy    User              @relation("TestCaseCreatedBy", fields: [createdById], references: [id])
  steps        TestCaseStep[]
  history      TestCaseHistory[]
  requirements RequirementCase[]
  planItems    PlanCase[]
  runCases     RunCase[]

  @@index([projectId])
  @@map("test_cases")
}

model TestCaseStep {
  id             String  @id @default(uuid())
  testCaseId     String
  position       Int
  action         String
  expectedResult String?

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("test_case_steps")
}

// FR-015: basic audit/change history
model TestCaseHistory {
  id         String   @id @default(uuid())
  testCaseId String
  changedById String
  changedAt  DateTime @default(now())
  summary    Json // before/after summary of the changed fields

  testCase  TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedById], references: [id])

  @@index([testCaseId])
  @@map("test_case_history")
}

// ---------------------------------------------------------------------------
// Requirements traceability (FR-020..FR-023)
// ---------------------------------------------------------------------------

enum RequirementStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Requirement {
  id          String            @id @default(uuid())
  projectId   String
  title       String
  description String?
  externalRef String? // external system reference (ID/URL) - content sync is out of MVP scope
  status      RequirementStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases   RequirementCase[]

  @@index([projectId])
  @@map("requirements")
}

model RequirementCase {
  requirementId String
  testCaseId    String
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCase    TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@id([requirementId, testCaseId])
  @@map("requirement_cases")
}

// ---------------------------------------------------------------------------
// Milestones / Plans / Runs / Results (FR-030..FR-036, FR-040..FR-046)
// ---------------------------------------------------------------------------

model Milestone {
  id        String    @id @default(uuid())
  projectId String
  name      String
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plans   TestPlan[]
  runs    TestRun[]

  @@map("milestones")
}

model TestPlan {
  id            String    @id @default(uuid())
  projectId     String
  title         String
  description   String?
  milestoneId   String?
  environment   String?
  configuration String?
  createdById   String
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  createdBy User       @relation("TestPlanCreatedBy", fields: [createdById], references: [id])
  items     PlanCase[]
  runs      TestRun[]

  @@map("test_plans")
}

model PlanCase {
  id         String  @id @default(uuid())
  planId     String
  testCaseId String
  assigneeId String?
  // How runs started from the plan run this case: by a tester or by CI. Set in the plan's case
  // list; a case joins the plan as it is defined (its automation status).
  executionMode ExecutionMode @default(MANUAL)
  position   Int     @default(0)

  plan     TestPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([planId, testCaseId])
  @@map("plan_cases")
}

enum RunSource {
  MANUAL
  CI
}

enum RunStatus {
  OPEN
  COMPLETED
}

model TestRun {
  id                   String    @id @default(uuid())
  projectId            String
  planId               String?
  milestoneId          String?
  title                String
  description          String?
  tags                 String[]  @default([])
  environment          String?
  build                String? // CI build/commit/version info
  configuration        String?
  source               RunSource @default(MANUAL)
  status               RunStatus @default(OPEN)
  externalLinkType     String? // e.g. JiraCloud, GitHub, GitLab, Linear, CustomField
  externalLinkRef      String?
  publicShareEnabled   Boolean   @default(false)
  publicShareToken     String?   @unique
  createdById          String
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan      TestPlan?  @relation(fields: [planId], references: [id])
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  createdBy User       @relation("TestRunCreatedBy", fields: [createdById], references: [id])
  runCases  RunCase[]
  webhookDeliveries WebhookDelivery[]

  @@index([projectId])
  @@map("test_runs")
}

enum RunCaseStatus {
  UNTESTED
  PASSED
  FAILED
  BLOCKED
  SKIPPED
  INVALID // could not be finished properly, so the outcome is inconclusive
  RETEST // to be run again; its earlier attempts stay in the run's history
}

// A snapshot of the test case is taken when the run starts (FR: case version is preserved)
/// How a case of a run is meant to be run: by a tester, or by automation from CI. Chosen when the
/// run starts, for that run only; the case's own automationStatus is the default.
enum ExecutionMode {
  MANUAL
  AUTOMATED
}

model RunCase {
  id            String        @id @default(uuid())
  runId         String
  testCaseId    String
  assigneeId    String?
  status        RunCaseStatus @default(UNTESTED)
  executionMode ExecutionMode @default(MANUAL)
  caseSnapshot Json // snapshot of the case title/steps/preconditions at run start
  position     Int           @default(0)

  run      TestRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase   @relation(fields: [testCaseId], references: [id])
  results  Result[]

  @@unique([runId, testCaseId])
  @@map("run_cases")
}

enum ResultStatus {
  PASSED
  FAILED
  BLOCKED
  SKIPPED
  INVALID // could not be finished properly, so the outcome is inconclusive
  UNTESTED
}

enum ResultSource {
  MANUAL
  AUTOMATION
}

model Result {
  id                    String       @id @default(uuid())
  runCaseId             String
  status                ResultStatus
  comment               String?
  source                ResultSource @default(MANUAL)
  authorUserId          String?
  automationSourceLabel String? // e.g. CI job name / framework
  startedAt             DateTime?
  endedAt               DateTime?
  durationMs            Int?
  attemptNumber         Int          @default(1) // retry attempts (FR-043)
  isLatest              Boolean      @default(true)
  externalTestId        String? // external test ID for idempotency (FR-075)
  createdAt             DateTime     @default(now())

  runCase     RunCase       @relation(fields: [runCaseId], references: [id], onDelete: Cascade)
  author      User?         @relation("ResultAuthor", fields: [authorUserId], references: [id])
  stepResults StepResult[]
  attachments Attachment[]
  defects     DefectResult[]

  // Parallel CI jobs must not create the same attempt twice or a second result for an
  // external test ID (FR-043, FR-075). Exactly one isLatest row per run case is kept by
  // ResultsService, which writes results under a lock per run case.
  @@unique([runCaseId, attemptNumber])
  @@unique([runCaseId, externalTestId])
  @@index([runCaseId])
  @@index([externalTestId])
  @@map("results")
}

model StepResult {
  id           String       @id @default(uuid())
  resultId     String
  stepPosition Int
  status       ResultStatus
  comment      String?

  result      Result       @relation(fields: [resultId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([resultId])
  @@map("step_results")
}

// ---------------------------------------------------------------------------
// Attachments: content lives on the persistent volume, only metadata here (FR-045..FR-046)
// ---------------------------------------------------------------------------

model Attachment {
  id              String   @id @default(uuid())
  uploaderUserId  String?
  resultId        String?
  stepResultId    String?
  defectId        String?
  fileName        String
  mimeType        String
  sizeBytes       Int
  checksumSha256  String
  storageKey      String // relative path inside the persistent volume
  createdAt       DateTime @default(now())

  uploader   User?       @relation("AttachmentUploader", fields: [uploaderUserId], references: [id])
  result     Result?     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  stepResult StepResult? @relation(fields: [stepResultId], references: [id], onDelete: Cascade)
  defect     Defect?     @relation(fields: [defectId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Defects (FR-050..FR-053)
// ---------------------------------------------------------------------------

enum DefectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DefectStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Defect {
  id               String         @id @default(uuid())
  projectId        String
  title            String
  description      String?
  severity         DefectSeverity @default(MEDIUM)
  status           DefectStatus   @default(OPEN)
  assigneeId       String?
  tags             String[]       @default([])
  externalProvider String? // e.g. Jira, GitHub, GitLab, Azure DevOps, Linear, Trello, YouTrack, custom
  externalIssueId  String?
  externalUrl      String?
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("DefectCreatedBy", fields: [createdById], references: [id])
  results     DefectResult[]
  attachments Attachment[]

  @@index([projectId])
  @@map("defects")
}

model DefectResult {
  defectId  String
  resultId  String
  createdAt DateTime @default(now())

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)
  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@id([defectId, resultId])
  @@map("defect_results")
}

// ---------------------------------------------------------------------------
// API tokens & audit log (FR-073, Section 8)
// ---------------------------------------------------------------------------

model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime? // null: the token doesn't expire
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?
  projectId   String?
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([projectId])
  @@map("audit_log")
}
