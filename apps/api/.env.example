# PostgreSQL connection used by Prisma and the API
DATABASE_URL="postgresql://testops:testops@localhost:5432/testops?schema=public"

# JWT signing secret for web session tokens. With NODE_ENV=production the API refuses
# to start if this is empty, a placeholder or shorter than 32 chars (openssl rand -hex 32).
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# Directory where attachment files are stored (mounted as a persistent Docker volume in production)
ATTACHMENTS_DIR="./data/attachments"

# Upload limits (bytes / count) enforced per request
ATTACHMENT_MAX_FILE_SIZE_BYTES=33554432
ATTACHMENT_MAX_REQUEST_SIZE_BYTES=134217728
ATTACHMENT_MAX_FILES_PER_REQUEST=20
# Comma-separated allowlist (e.g. png,jpg,log,zip). Empty = built-in default list (no svg).
ATTACHMENT_ALLOWED_EXTENSIONS=

PORT=3000
LOG_LEVEL="log"
