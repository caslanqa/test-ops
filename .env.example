# Docker Compose için ortam değişkenleri (design-doc.md bölüm 7: secret'lar image'a gömülmez)
POSTGRES_USER=testops
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=testops
# Postgres yalnızca 127.0.0.1 üzerinde açılır (ör. host'tan prisma migrate dev); portu buradan değiştirin
POSTGRES_PORT=5432

# Boş bırakılırsa scripts/start.sh rastgele üretir. Elle: openssl rand -hex 32
# Uygulama örnek değerle veya 32 karakterden kısa secret ile başlamaz.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Kendi kendine kayıt (giriş ekranında "Kayıt ol"). Kapalı kurulumlarda false yapın;
# o durumda hesapları workspace admin'leri üye eklerken oluşturur.
SELF_REGISTRATION=true

# Uygulamanın (API+UI tek imaj) host tarafında dinleyeceği port; istediğiniz gibi değiştirin
APP_PORT=8080

# Ek dosya sınırları (FR-045); boş bırakılırsa 32 MB / 128 MB / 20 dosya ve varsayılan uzantı listesi
ATTACHMENT_MAX_FILE_SIZE_BYTES=
ATTACHMENT_MAX_REQUEST_SIZE_BYTES=
ATTACHMENT_MAX_FILES_PER_REQUEST=
# Virgülle ayrılmış, ör. png,jpg,log,zip. Varsayılan: görüntü, video, metin/log, json/xml/html, pdf, arşiv (svg hariç)
ATTACHMENT_ALLOWED_EXTENSIONS=
# Registry'den çekilen imajı kullanmak için ör. ghcr.io/<owner>/testops:latest
APP_IMAGE=testops:local
