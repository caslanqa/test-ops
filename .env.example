# Environment variables for Docker Compose (design-doc.md section 7: secrets are not baked into the image).
# Only JWT_SECRET and POSTGRES_PASSWORD are required for installation; the rest have defaults (see README.md).
POSTGRES_USER=testops
# Do not change after the first install: Postgres stores the password when the volume is first created.
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=testops
# Development only (docker-compose.override.yml): Postgres port on 127.0.0.1
POSTGRES_PORT=5432

# Required. Generate with: openssl rand -hex 32 (inside the repo, scripts/start.sh generates one if empty)
# The app does not start with the example value or with a secret shorter than 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Self-registration ("Create one" link on the login screen). Set to false for closed installations;
# accounts are then created by workspace admins when they add members.
SELF_REGISTRATION=true

# Request limits (per minute, 0 = disabled). If left empty:
#   general API 600 (per signed-in user or per anonymous IP; CI tokens are included),
#   login/registration/password change 10 (per account + IP), 60 across all accounts from the same IP.
# Counters are kept in memory; if you run more than one replica, the limits apply per replica.
RATE_LIMIT_PER_MINUTE=
AUTH_RATE_LIMIT_PER_MINUTE=
AUTH_IP_RATE_LIMIT_PER_MINUTE=
# If the app runs behind a reverse proxy (nginx, Traefik, load balancer), set this so the client IP
# is read from X-Forwarded-For: true, the number of proxy hops (e.g. 1) or trusted addresses
# (e.g. 10.0.0.0/8). Leave empty when exposed directly; otherwise the limit can be bypassed by spoofing the header.
TRUST_PROXY=

# Host port the app (API+UI single image) listens on; change it as you like
APP_PORT=8080

# Largest JSON request body in bytes, e.g. a bulk upload of up to 500 results with their failure
# messages (FR-074). If left empty: 10 MiB. File uploads use the ATTACHMENT_* limits below.
JSON_MAX_REQUEST_SIZE_BYTES=

# Attachment limits (FR-045); if left empty: 32 MB / 128 MB / 20 files and the default extension list
ATTACHMENT_MAX_FILE_SIZE_BYTES=
ATTACHMENT_MAX_REQUEST_SIZE_BYTES=
ATTACHMENT_MAX_FILES_PER_REQUEST=
# Comma-separated, e.g. png,jpg,log,zip. Default: images, video, text/log, json/xml/html, pdf, archives (no svg)
ATTACHMENT_ALLOWED_EXTENSIONS=
# Image to run. If empty, installations use ghcr.io/caslanqa/testops:latest and the repo uses a local build
# (testops:local). To pin a version, e.g. ghcr.io/caslanqa/testops:0.2.0
APP_IMAGE=
